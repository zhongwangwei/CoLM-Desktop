# =======================================================
# macOS ARM64 / Homebrew gfortran + OpenMPI
# Local build options; keep Makeoptions.github Linux-only for CI.
#

  FF = mpif90 -fopenmp

  NETCDF_PREFIX ?= /opt/homebrew
  NETCDF_LIB = $(NETCDF_PREFIX)/lib
  NETCDF_INC = $(NETCDF_PREFIX)/include

  MOD_CMD = -J

# Desktop releases run the optimized profile.  Developers can retain the
# former bounds-checked build with COLM_KERNEL_PROFILE=debug.
  COLM_KERNEL_PROFILE ?= production
  FOPTS_COMMON = -fdefault-real-8 -ffree-form -g \
                 -ffpe-trap=invalid,zero,overflow \
                 -fbacktrace -fdump-core -cpp -ffree-line-length-0

# determine the gfortran version
  GCC_VERSION := "`gcc -dumpversion`"
  IS_GCC_ABOVE_10 := $(shell expr "$(GCC_VERSION)" ">=" "10")
  ifeq "$(IS_GCC_ABOVE_10)" "1"
     FOPTS_COMMON += -fallow-argument-mismatch
  endif

  FOPTS_PRODUCTION = -O2 $(FOPTS_COMMON)
  FOPTS_DEBUG = -O0 -C -fbounds-check $(FOPTS_COMMON)
  ifeq "$(COLM_KERNEL_PROFILE)" "production"
     FOPTS = $(FOPTS_PRODUCTION)
  else ifeq "$(COLM_KERNEL_PROFILE)" "debug"
     FOPTS = $(FOPTS_DEBUG)
  else
     $(error COLM_KERNEL_PROFILE must be production or debug)
  endif

  INCLUDE_DIR = -I../include -I../share -I../mksrfdata -I../mkinidata -I../main -I$(NETCDF_INC)
  LDFLAGS = -L$(NETCDF_LIB) -lnetcdff -lnetcdf -llapack -lblas



#============================================================
# CaMa-Flood Mkinclude (macOS ARM64, gfortran)

RM = /bin/rm -f
CP = /bin/cp
#----
# Pre-Prosessing options
# DMPI=-DUseMPI: activate when MPI parallelization is used
# DCDF=-DUseCDF: activate when using netCDF, comment out when not needed
# DATM=-DNoAtom: activate when OMP ATOMIC calculation should be avoided (bit identical simulation)
#----
#DMPI=-DUseMPI
DCDF=-DUseCDF -DUseCDF_CMF
#DATM=-DNoAtom
CFLAGS=$(DMPI) $(DCDF) $(DATM)
#----
FCMP = gfortran -fopenmp
FC   = gfortran

LFLAGS =
FFLAGS = -O0 -Wall -cpp -free -fimplicit-none -fbounds-check -fbacktrace
