{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoLM Desktop",
  "version": "0.2.0-beta.2",
  "identifier": "edu.sysu.colm.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CoLM Desktop",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": false,
    "publisher": "CoLM LSM Development Team",
    "copyright": "Copyright © 2026 CoLM LSM Development Team, School of Atmospheric Sciences, SYSU\nContact: Zhongwang Wei (魏忠旺)\nweizhw6@mail.sysu.edu.cn",
    "homepage": "https://github.com/zhongwangwei/CoLM-Desktop",
    "license": "MIT OR Apache-2.0",
    "shortDescription": "CoLM single-site simulation and evaluation desktop application",
    "longDescription": "CoLM Desktop is developed and maintained by the CoLM LSM Development Team, School of Atmospheric Sciences, SYSU. Contact: Zhongwang Wei (魏忠旺), weizhw6@mail.sysu.edu.cn.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
