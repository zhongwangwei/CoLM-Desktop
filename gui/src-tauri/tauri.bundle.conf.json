{
  "build": {
    "beforeBuildCommand": "cargo run -q -p xtask --manifest-path ../xtask/Cargo.toml -- stage-sidecar"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/colm-cli",
      "binaries/mksrfdata-rs",
      "binaries/mkinidata-rs",
      "binaries/colm-rs",
      "binaries/colm-agent"
    ],
    "resources": {
      "../../kernels": "kernels",
      "../../examples": "examples"
    }
  }
}
