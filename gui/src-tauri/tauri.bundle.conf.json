{
  "build": {
    "beforeBuildCommand": "npm run build && python3 ../oracle/scripts/ensure_native_kernels.py && cargo run -q -p xtask --manifest-path ../xtask/Cargo.toml -- stage-sidecar"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/colm-cli",
      "binaries/mksrfdata-rs",
      "binaries/mkinidata-rs",
      "binaries/colm-rs",
      "binaries/colm-agent",
      "binaries/colm-mcp"
    ],
    "resources": {
      "../../kernels": "kernels",
      "../../examples": "examples",
      "engine": "engine",
      "engine/docs": "docs",
      "binaries/colm-build-source.json": "colm-build-source.json"
    }
  }
}
